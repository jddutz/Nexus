{
    "Application": {
        "ApplicationName": "Hello Nexus",
        "ApplicationVersion": "1.0.0"
    },
    "Diagnostics": {
        "EnableProfiling": true
    },
    "Logging": {
        "LogLevel": {
            "Default": "Trace"
        },
        "Console": {
            "FormatterName": "simple",
            "FormatterOptions": {
                "SingleLine": true,
                "TimestampFormat": "HH:mm:ss.fff ",
                "UseUtcTimestamp": false,
                "IncludeScopes": true
            }
        }
    },
    "Window": {
        "Title": "Hello Nexus",
        "Width": 1280,
        "Height": 720,
        "VSync": true,
        "Resizable": true,
        "Mode": "Normal"
    },
    "Graphics": {
        "EnableValidationLayers": true,
        "EnableSwapchainTransfer": true
    }
}