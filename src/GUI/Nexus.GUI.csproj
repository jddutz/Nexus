<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NXS013</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Silk.NET.Input" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\..\codegen\Nexus.SourceGenerators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference Include="..\Core\Nexus.Core.csproj" />
    <ProjectReference Include="..\Graphics\Nexus.Graphics.csproj" />
    <ProjectReference Include="..\Input\Nexus.Input.csproj" />
  </ItemGroup>
</Project>
