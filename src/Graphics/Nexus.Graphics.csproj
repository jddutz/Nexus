    <PackageReference Include="StbImageSharp" />
    <ProjectReference Include="..\Core\Nexus.Core.csproj" />
    <ProjectReference Include="..\Assets\Nexus.Assets.csproj" />
    <ProjectReference
      Include="..\..\codegen\Nexus.SourceGenerators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
